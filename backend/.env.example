# ===========================================================================
# AI Chat Assistant —— 后端环境变量示例
# 使用方法：cp .env.example .env 然后按需修改
# 所有配置项都有合理默认值，不配置也能用内置 mock 模型跑通全流程
# ===========================================================================

# ------------------------------- 应用 -------------------------------------
APP_NAME=AI Chat Assistant
APP_ENV=dev
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api

# ------------------------------- 数据库 -----------------------------------
# 方案 A：MySQL 8.x（推荐，本项目当前使用）
#   建库：CREATE DATABASE ai_chat DEFAULT CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
#   建表：cd backend && alembic upgrade head
DATABASE_URL=mysql+aiomysql://root:your_password@127.0.0.1:3306/ai_chat?charset=utf8mb4
#
# 方案 B：SQLite（本地零依赖演示）
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
#
# 启动时是否自动 create_all：
#   SQLite / 快速演示 -> true
#   MySQL / 长期环境  -> false（用 alembic 管理表结构，启动时只做表结构自检）
AUTO_CREATE_TABLES=false
#
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ------------------------------- 安全 -------------------------------------
# 生产环境务必替换：python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=please-change-me-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
# 留空则由 SECRET_KEY 派生 Fernet Key；生产环境建议单独生成：
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=
PASSWORD_MIN_LENGTH=6

# ------------------------------- CORS -------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ------------------------------ 文件存储 ----------------------------------
STORAGE_DIR=storage
UPLOAD_DIR=storage/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_EXTENSIONS=.pdf,.docx,.txt,.md,.markdown,.csv,.xlsx

# ------------------------------ 向量存储 ----------------------------------
# sql = 内置实现（向量存数据库，无需额外依赖，默认）
# chroma = 需要 pip install chromadb langchain-chroma
VECTOR_STORE=sql
VECTOR_DIR=storage/vectors
DEFAULT_EMBEDDING_PROVIDER=local
DEFAULT_EMBEDDING_MODEL=local-hash-512
EMBEDDING_DIMENSION=512
EMBEDDING_BATCH_SIZE=32

# ------------------------------ RAG 默认值 --------------------------------
DEFAULT_CHUNK_SIZE=800
DEFAULT_CHUNK_OVERLAP=120
DEFAULT_TOP_K=4
DEFAULT_SIMILARITY_THRESHOLD=0.2

# ------------------------------ LLM ---------------------------------------
LLM_REQUEST_TIMEOUT=180
LLM_MAX_RETRIES=2
MAX_CONTEXT_MESSAGES=20
MAX_CONTEXT_CHARS=24000

# 首次启动自动创建的默认模型（留空 = 创建内置 mock 模型，无需 API Key）
SEED_DEFAULT_MODEL=true
DEFAULT_PROVIDER=mock
DEFAULT_MODEL_NAME=mock-chat
DEFAULT_BASE_URL=
DEFAULT_API_KEY=
#
# 例：使用 DeepSeek
#   DEFAULT_PROVIDER=deepseek
#   DEFAULT_MODEL_NAME=deepseek-chat
#   DEFAULT_BASE_URL=https://api.deepseek.com/v1
#   DEFAULT_API_KEY=sk-xxxxxxxx
# 例：使用本地 Ollama
#   DEFAULT_PROVIDER=ollama
#   DEFAULT_MODEL_NAME=qwen2.5:7b
#   DEFAULT_BASE_URL=http://127.0.0.1:11434/v1
#   DEFAULT_API_KEY=

# 首次启动自动创建的管理员（生产环境请务必修改）
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123456
DEFAULT_ADMIN_EMAIL=

# ------------------------------- 日志 -------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_TO_FILE=true
LOG_SQL=false
